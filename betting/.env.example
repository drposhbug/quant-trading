# Copy this file to .env and fill in your real keys. Never commit .env.
XAI_API_KEY=
GOOGLE_API_KEY=
ODDS_API_KEY=

# Optional overrides
GROK_MODEL=grok-4
GEMINI_MODEL=gemini-2.5-flash

# Polymarket execution (trader.py). Leave blank to stay in DRY mode.
# Going live needs ALL THREE: --live flag, POLYMARKET_LIVE=1, and the key.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_LIVE=0
# Optional: proxy/funder wallet address and signature type (0 = EOA)
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=0
